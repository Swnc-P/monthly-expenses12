  }, []);

  // 2. ดึงและซิงค์ข้อมูลแบบ Real-time จาก Cloud ตามอีเมลที่ล็อกอิน
  useEffect(() => {
    if (!cloudUser || !cloudDb || !cloudEmail || !isLoggedIn) return;
    const docKey = `account_${normalizeEmailKey(cloudEmail)}`;
    const docRef = doc(cloudDb, 'artifacts', currentAppId, 'public', 'data', 'user_budgets', docKey);

    setSyncStatus('loading');
    const unsubscribe = onSnapshot(
      docRef,
      (snap) => {
        if (snap.exists()) {
          const data = snap.data();
          if (data && data.sheetsJson && data.sheetsJson !== lastSavedHashRef.current) {
            try {
              const parsed = JSON.parse(data.sheetsJson);
              if (Array.isArray(parsed) && parsed.length > 0) {
                isRemoteUpdateRef.current = true;
                lastSavedHashRef.current = data.sheetsJson;
                setSheets(parsed);
                if (data.activeSheetId) setActiveSheetId(data.activeSheetId);
              }
            } catch (e) {}
          }
          setLastSyncedAt(new Date());
          setSyncStatus('synced');
        } else {
          const jsonStr = JSON.stringify(sheets);
          lastSavedHashRef.current = jsonStr;
          setDoc(docRef, {
            email: cloudEmail,
            sheetsJson: jsonStr,
            activeSheetId: activeSheetId,
            updatedAt: new Date().toISOString()
          }).then(() => {
            setLastSyncedAt(new Date());
            setSyncStatus('synced');
