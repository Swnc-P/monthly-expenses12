              </div>
              {lastSyncedAt && (
                <span className="text-[11px] font-mono text-emerald-400 bg-emerald-500/10 border border-emerald-500/30 px-2.5 py-1 rounded-full">
                  ซิงค์ล่าสุด: {lastSyncedAt.toLocaleTimeString('th-TH')}
                </span>
              )}
            </div>

            <form onSubmit={handleSaveCloudSettings} className="space-y-4">
              <div className="bg-[#090D16] p-4 rounded-xl border border-emerald-500/30 space-y-2.5">
                <label className="block text-xs font-bold text-emerald-300">
                  Google Apps Script Web App URL (ลงท้ายด้วย /exec)
                </label>
                <div className="relative">
                  <Key className="w-4 h-4 text-emerald-400 absolute left-3 top-1/2 -translate-y-1/2" />
                  <input
                    type="url"
                    required
                    placeholder="https://script.google.com/macros/s/AKfycb.../exec"
                    value={inputGasUrl}
                    onChange={(e) => setInputGasUrl(e.target.value)}
                    className="w-full pl-9 pr-3.5 py-2.5 bg-[#111827] border border-slate-700 rounded-xl text-xs text-white focus:outline-none focus:border-emerald-500 font-mono"
                  />
                </div>
                <p className="text-[11px] text-slate-400 leading-relaxed">
                  💡 ทุกตัวเลข ทั้ง 4 หมวดหมู่ และข้อมูลย้อนหลังทุกเดือน จะถูกบันทึกอัตโนมัติลง Google Sheets ทันทีที่แก้ไข
                </p>
              </div>

              <div className="flex items-center justify-between pt-2 border-t border-slate-800">
                <button
                  type="button"
                  onClick={() => {
                    setCloudModal(false);
                    setShowCodeModal(true);
                  }}
                  className="text-xs text-blue-400 hover:underline flex items-center gap-1 cursor-pointer"
                >
                  <Code2 className="w-3.5 h-3.5" />
                  <span>ดูโค้ด Code.gs</span>
                </button>
                <div className="flex items-center gap-2">
                  <button
                    type="button"
                    onClick={() => setCloudModal(false)}
                    className="px-4 py-2 text-xs font-medium text-slate-400 hover:text-white rounded-xl cursor-pointer"
                  >
                    ปิด
                  </button>
                  <button
                    type="submit"
                    className="px-4 py-2 text-xs font-semibold bg-emerald-600 hover:bg-emerald-500 text-white rounded-xl cursor-pointer"
                  >
                    บันทึก URL & ซิงค์ข้อมูล 100%
                  </button>
                </div>
              </div>
            </form>
          </div>
        </div>
      )}

      {/* Modal แสดงโค้ด Code.gs สำหรับคัดลอก */}
      {showCodeModal && (
        <div className="fixed inset-0 z-50 bg-black/80 backdrop-blur-sm flex items-center justify-center p-4">
          <div className="bg-[#111827] border border-slate-700 rounded-2xl max-w-2xl w-full p-6 space-y-4 shadow-2xl">
            <div className="flex items-center justify-between gap-2">
              <div>
                <h3 className="text-base font-bold text-white">โค้ดสำหรับ Google Apps Script (Code.gs)</h3>
                <p className="text-xs text-slate-400">คัดลอกไปวางใน Extensions &gt; Apps Script แล้วกด Deploy &gt; New deployment (เลือก Anyone)</p>
              </div>
              <button
                type="button"
                onClick={copyCodeGsToClipboard}
                className="px-3.5 py-2 rounded-xl text-xs font-bold bg-blue-600 hover:bg-blue-500 text-white flex items-center gap-1.5 cursor-pointer shrink-0"
              >
                <Copy className="w-3.5 h-3.5" />
                <span>คัดลอก Code.gs</span>
              </button>
            </div>
            <pre className="bg-[#090D16] border border-slate-800 rounded-xl p-4 text-[11px] font-mono text-emerald-300 overflow-x-auto max-h-80">
              {GAS_CODE_TEMPLATE}
            </pre>
            <div className="flex justify-end">
              <button
                type="button"
                onClick={() => setShowCodeModal(false)}
                className="px-4 py-2 rounded-xl text-xs font-semibold bg-slate-800 hover:bg-slate-700 text-white cursor-pointer"
              >
                ปิดหน้าต่าง
              </button>
            </div>
          </div>
        </div>
      )}
    </div>
  );
}
