  };

  const handleDragEnterRow = (listKey, targetId, startNo = 1) => {
    if (!draggedItem || draggedItem.listKey !== listKey || draggedItem.id === targetId) return;

    updateCurrentSheet((sheet) => {
      const list = [...(sheet[listKey] || [])];
      const fromIdx = list.findIndex((r) => r.id === draggedItem.id);
      const toIdx = list.findIndex((r) => r.id === targetId);
      if (fromIdx === -1 || toIdx === -1 || fromIdx === toIdx) return sheet;

      const [moved] = list.splice(fromIdx, 1);
      list.splice(toIdx, 0, moved);

      const renumbered = list.map((item, i) => ({
        ...item,
        no: String(startNo + i),
      }));

      return {
        ...sheet,
        [listKey]: renumbered,
      };
    });
  };

