const migrateRowStatus = (row) => {
  if (row.status !== undefined) return row.status;
  if (row.isPaid || row.isPriority) return 'paid';
  return Number(row.amount) > 0 ? 'pending' : 'none';
};

const computeSheetSummary = (sheet) => {
  const essentialExpenses = (sheet.essentialExpenses || []).map(r => ({ ...r, status: migrateRowStatus(r) }));
  const investments = (sheet.investments || []).map(r => ({ ...r, status: migrateRowStatus(r) }));

  const essentialTotal = essentialExpenses.reduce((sum, r) => sum + (Number(r.amount) || 0), 0);
  const essentialPaidTotal = essentialExpenses.reduce((sum, r) => sum + (r.status === 'paid' ? Number(r.amount) || 0 : 0), 0);
  const essentialPendingTotal = essentialExpenses.reduce((sum, r) => sum + (r.status === 'pending' ? Number(r.amount) || 0 : 0), 0);
  const essentialPaidCount = essentialExpenses.filter((r) => r.status === 'paid').length;
  const essentialPendingCount = essentialExpenses.filter((r) => r.status === 'pending').length;

  const investmentTotal = investments.reduce((sum, r) => sum + (Number(r.amount) || 0), 0);
  const investmentPaidTotal = investments.reduce((sum, r) => sum + (r.status === 'paid' ? Number(r.amount) || 0 : 0), 0);
  const investmentPendingTotal = investments.reduce((sum, r) => sum + (r.status === 'pending' ? Number(r.amount) || 0 : 0), 0);
  const investmentPaidCount = investments.filter((r) => r.status === 'paid').length;
  const investmentPendingCount = investments.filter((r) => r.status === 'pending').length;

  const incomeTotal = (sheet.incomes || []).reduce((sum, r) => sum + (Number(r.amount) || 0), 0);
  const extraExpenseTotal = (sheet.extraExpenses || []).reduce((sum, r) => sum + (Number(r.amount) || 0), 0);
  const totalAllExpenses = essentialTotal + investmentTotal + extraExpenseTotal;
  const netRemaining = incomeTotal - totalAllExpenses;

  return {
    essentialTotal,
    essentialPaidTotal,
    essentialPendingTotal,
    essentialPaidCount,
    essentialPendingCount,
    investmentTotal,
    investmentPaidTotal,
    investmentPendingTotal,
    investmentPaidCount,
    investmentPendingCount,
    incomeTotal,
    extraExpenseTotal,
    totalAllExpenses,
    netRemaining,
  };
};

const formatCurrency = (num) => {
  const value = Number(num) || 0;
  return value.toLocaleString('en-US', {
    minimumFractionDigits: 2,
    maximumFractionDigits: 2,
  });
};

const EditableNumberCell = ({ value, onChange, status = 'none', placeholder = '0.00' }) => {
  const [isFocused, setIsFocused] = useState(false);
  const [tempVal, setTempVal] = useState(value === 0 ? '' : String(value));

  useEffect(() => {
    if (!isFocused) {
      setTempVal(value === 0 ? '' : String(value));
    }
  }, [value, isFocused]);

  const handleFocus = () => {
    setIsFocused(true);
    setTempVal(value === 0 ? '' : String(value));
  };

  const handleBlur = () => {
    setIsFocused(false);
    const parsed = parseFloat(String(tempVal).replace(/,/g, ''));
    onChange(isNaN(parsed) ? 0 : parsed);
  };

  const handleKeyDown = (e) => {
    if (e.key === 'Enter') {
      e.target.blur();
    }
  };

  const displayText = () => {
    if (isFocused) return tempVal;
    if (!value || Number(value) === 0) return '0.00';
    return formatCurrency(value);
  };

  return (
    <div className="relative flex items-center justify-end">
      <input
        type={isFocused ? 'number' : 'text'}
        step="any"
        value={displayText()}
        placeholder={placeholder}
        onFocus={handleFocus}
        onBlur={handleBlur}
        onChange={(e) => setTempVal(e.target.value)}
        onKeyDown={handleKeyDown}
        className={`w-full px-3 py-1.5 text-right font-mono text-sm rounded-lg border transition-all duration-150 focus:outline-none ${
          isFocused
            ? 'bg-[#090D16] border-blue-500 text-white ring-2 ring-blue-500/30'
            : status === 'paid'
            ? 'bg-rose-500/20 border-rose-500/50 text-rose-300 font-semibold shadow-[0_0_10px_rgba(244,63,94,0.15)] hover:border-rose-400'
            : status === 'pending'
            ? 'bg-amber-500/20 border-amber-500/50 text-amber-300 font-semibold shadow-[0_0_10px_rgba(245,158,11,0.15)] hover:border-amber-400'
            : Number(value) > 0
            ? 'bg-[#0D1322]/70 border-slate-800/80 text-slate-100 hover:border-slate-700 hover:bg-[#0D1322]'
            : 'bg-transparent border-transparent text-slate-500 hover:border-slate-800 hover:bg-[#0D1322]/40'
        }`}
      />
    </div>
  );
};

