          {/* Modal สร้างเดือนใหม่ */}
          {newMonthModal && (
            <div className="fixed inset-0 z-50 bg-black/70 flex items-center justify-center p-4">
              <div className="bg-[#111827] rounded-2xl max-w-md w-full p-6 border border-slate-800">
                <h3 className="text-base font-bold text-white mb-3">สร้างงบประมาณเดือนใหม่</h3>
                <form onSubmit={handleCreateNewMonth} className="space-y-4">
                  <input
                    type="text"
                    required
                    placeholder="เช่น ธ.ค. 2026"
                    value={newMonthName}
                    onChange={(e) => setNewMonthName(e.target.value)}
                    className="w-full px-3.5 py-2 bg-[#090D16] border border-slate-800 rounded-xl text-sm text-white"
                  />
                  <label className="flex items-center gap-2 text-xs text-slate-300 cursor-pointer">
                    <input type="checkbox" checked={copyFromCurrent} onChange={(e) => setCopyFromCurrent(e.target.checked)} />
                    <span>คัดลอกโครงสร้างรายการจากเดือนปัจจุบัน ({currentSheet.name})</span>
                  </label>
                  <div className="flex justify-end gap-2">
                    <button type="button" onClick={() => setNewMonthModal(false)} className="px-4 py-2 text-xs text-slate-400">ยกเลิก</button>
                    <button type="submit" className="px-4 py-2 text-xs font-semibold bg-blue-600 text-white rounded-xl">สร้างเดือนใหม่</button>
                  </div>
                </form>
              </div>
            </div>
          )}

          {/* Modal แก้ไขชื่อเดือน */}
          {editMonthModal && (
            <div className="fixed inset-0 z-50 bg-black/70 flex items-center justify-center p-4">
              <div className="bg-[#111827] rounded-2xl max-w-md w-full p-6 border border-slate-800">
                <h3 className="text-base font-bold text-white mb-3">แก้ไขชื่อเดือน</h3>
                <form onSubmit={handleRenameMonth} className="space-y-4">
                  <input
                    type="text"
                    required
                    value={editMonthModal.name}
                    onChange={(e) => setEditMonthModal({ ...editMonthModal, name: e.target.value })}
                    className="w-full px-3.5 py-2 bg-[#090D16] border border-slate-800 rounded-xl text-sm text-white"
                  />
                  <div className="flex justify-end gap-2">
                    <button type="button" onClick={() => setEditMonthModal(null)} className="px-4 py-2 text-xs text-slate-400">ยกเลิก</button>
                    <button type="submit" className="px-4 py-2 text-xs font-semibold bg-blue-600 text-white rounded-xl">บันทึก</button>
                  </div>
                </form>
              </div>
            </div>
          )}

          {/* Modal ยืนยันการลบเดือน */}
          {deleteMonthModal && (
            <div className="fixed inset-0 z-50 bg-black/70 flex items-center justify-center p-4">
              <div className="bg-[#111827] rounded-2xl max-w-md w-full p-6 border border-slate-800">
                <h3 className="text-base font-bold text-white mb-2">ยืนยันการลบเดือน "{deleteMonthModal.name}"?</h3>
                <p className="text-xs text-slate-400 mb-5">ข้อมูลในเดือนนี้จะถูกลบออกจากระบบ</p>
                <div className="flex justify-end gap-2">
                  <button type="button" onClick={() => setDeleteMonthModal(null)} className="px-4 py-2 text-xs text-slate-400">ยกเลิก</button>
                  <button type="button" onClick={() => handleDeleteMonthById(deleteMonthModal.id)} className="px-4 py-2 text-xs font-semibold bg-rose-600 text-white rounded-xl">ยืนยันลบเดือนนี้</button>
                </div>
              </div>
            </div>
          )}

          {/* Modal ล็อกอินอีเมลซิงค์ Cloud อัตโนมัติ */}
          {cloudModal && (
            <div className="fixed inset-0 z-50 bg-black/70 flex items-center justify-center p-4">
              <div className="bg-[#111827] rounded-2xl max-w-lg w-full p-6 border border-emerald-500/30">
                <div className="flex items-center justify-between mb-3">
                  <h3 className="text-base font-bold text-white">ตั้งค่าบัญชีอีเมลซิงค์ Cloud อัตโนมัติ</h3>
                  <button
                    type="button"
                    onClick={() => {
                      setCloudModal(false);
                      handleLogout();
                    }}
                    className="text-xs text-rose-400 hover:underline cursor-pointer"
                  >
                    ออกจากระบบ / สลับบัญชี
                  </button>
                </div>
                <form onSubmit={handleSaveCloudSettings} className="space-y-4">
                  <div className="bg-[#090D16] p-4 rounded-xl border border-emerald-500/30 space-y-2">
                    <label className="block text-xs font-bold text-emerald-300">1. อีเมลของคุณ (ใช้ซิงค์ข้ามคอม/มือถืออัตโนมัติ)</label>
                    <input
                      type="email"
                      required
                      placeholder="เช่น yourname@gmail.com"
                      value={inputCloudEmail}
                      onChange={(e) => setInputCloudEmail(e.target.value)}
                      className="w-full px-3.5 py-2 bg-[#111827] border border-slate-700 rounded-xl text-sm text-white font-mono"
                    />
                  </div>
                  <div className="bg-[#090D16]/70 p-4 rounded-xl border border-slate-800 space-y-2">
                    <label className="block text-xs font-semibold text-slate-300">2. Google Apps Script Web App URL (เสริม - ไม่บังคับ)</label>
                    <input
                      type="url"
                      placeholder="https://script.google.com/macros/s/AKfycb.../exec"
                      value={inputGasUrl}
                      onChange={(e) => setInputGasUrl(e.target.value)}
                      className="w-full px-3.5 py-2 bg-[#111827] border border-slate-800 rounded-xl text-xs text-slate-200 font-mono"
                    />
                  </div>
                  <div className="flex justify-end gap-2">
                    <button type="button" onClick={() => setCloudModal(false)} className="px-4 py-2 text-xs text-slate-400">ปิด</button>
                    <button type="submit" className="px-4 py-2 text-xs font-semibold bg-emerald-600 text-white rounded-xl">บันทึก & ซิงค์ข้อมูล</button>
                  </div>
                </form>
              </div>
            </div>
          )}
        </div>
      );
    }

    const root = ReactDOM.createRoot(document.getElementById('root'));
    root.render(<App />);
  </script>
</body>
</html>
