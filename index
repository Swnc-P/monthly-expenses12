      // Cloud Sync State
      const [inputCloudEmail, setInputCloudEmail] = useState('');
      const [gasUrl, setGasUrl] = useState(() => localStorage.getItem('monthly_expenses_gas_url') || '');
      const [inputGasUrl, setInputGasUrl] = useState('');
      const [cloudModal, setCloudModal] = useState(false);
      const [syncStatus, setSyncStatus] = useState('idle');
      const [lastSyncedAt, setLastSyncedAt] = useState(null);

      const cloudDbRef = useRef(null);
      const [cloudUser, setCloudUser] = useState(null);
      const isRemoteUpdateRef = useRef(false);
      const isInitialFetchedRef = useRef(false);
      const lastSavedHashRef = useRef('');

      const normalizeEmailKey = (str) => String(str || 'default').trim().toLowerCase().replace(/[^a-z0-9@._-]/g, '_');
      const currentAppId = typeof __app_id !== 'undefined' ? __app_id : 'monthly-expenses-app';

      const showToast = (msg) => {
        setToastMsg(msg);
        setTimeout(() => setToastMsg(null), 3000);
      };

      // Initialize Firebase when modules are ready
      useEffect(() => {
        const setupFirebase = async () => {
          const mods = window.__FIREBASE_MODULES__;
          if (!mods) return;
          try {
            if (typeof __firebase_config !== 'undefined' && __firebase_config) {
              const cfg = JSON.parse(__firebase_config);
              const app = mods.getApps().length === 0 ? mods.initializeApp(cfg) : mods.getApp();
              const auth = mods.getAuth(app);
              const db = mods.getFirestore(app);
              cloudDbRef.current = db;

              if (typeof __initial_auth_token !== 'undefined' && __initial_auth_token) {
                await mods.signInWithCustomToken(auth, __initial_auth_token);
              } else {
                await mods.signInAnonymously(auth);
              }
              mods.onAuthStateChanged(auth, (u) => setCloudUser(u));
            }
          } catch (e) {
            console.warn('Cloud init skipped:', e);
          }
        };

        if (window.__FIREBASE_MODULES__) {
          setupFirebase();
        } else {
          window.addEventListener('firebase-modules-ready', setupFirebase);
          return () => window.removeEventListener('firebase-modules-ready', setupFirebase);
        }
      }, []);

      // Real-time Firestore listener per Email
      useEffect(() => {
        const mods = window.__FIREBASE_MODULES__;
        if (!mods || !cloudUser || !cloudDbRef.current || !cloudEmail || !isLoggedIn) return;
        const docKey = `account_${normalizeEmailKey(cloudEmail)}`;
        const docRef = mods.doc(cloudDbRef.current, 'artifacts', currentAppId, 'public', 'data', 'user_budgets', docKey);

        setSyncStatus('loading');
        const unsubscribe = mods.onSnapshot(
          docRef,
          (snap) => {
            if (snap.exists()) {
              const data = snap.data();
              if (data && data.sheetsJson && data.sheetsJson !== lastSavedHashRef.current) {
                try {
                  const parsed = JSON.parse(data.sheetsJson);
                  if (Array.isArray(parsed) && parsed.length > 0) {
                    isRemoteUpdateRef.current = true;
                    lastSavedHashRef.current = data.sheetsJson;
                    setSheets(parsed);
                    if (data.activeSheetId) setActiveSheetId(data.activeSheetId);
                  }
                } catch (e) {}
              }
              setLastSyncedAt(new Date());
              setSyncStatus('synced');
            } else {
              const jsonStr = JSON.stringify(sheets);
              lastSavedHashRef.current = jsonStr;
              mods.setDoc(docRef, {
                email: cloudEmail,
                sheetsJson: jsonStr,
                activeSheetId: activeSheetId,
                updatedAt: new Date().toISOString()
              }).then(() => {
                setLastSyncedAt(new Date());
                setSyncStatus('synced');
              }).catch(() => {});
            }
            isInitialFetchedRef.current = true;
          },
          () => {
            if (!gasUrl) setSyncStatus('idle');
          }
        );
        return () => unsubscribe();
      }, [cloudUser, cloudEmail, isLoggedIn]);

      // Save to LocalStorage per user & global backup
      useEffect(() => {
        try {
          localStorage.setItem('monthly_expenses_dark_v3', JSON.stringify(sheets));
          if (cloudEmail) {
            localStorage.setItem(getStorageKey(cloudEmail), JSON.stringify(sheets));
          }
          localStorage.setItem('monthly_expenses_active_id_v3', activeSheetId);
        } catch (e) {}
      }, [sheets, activeSheetId, cloudEmail]);

      const fetchFromGoogleSheet = async (targetUrl = gasUrl, silent = false) => {
        if (!targetUrl) return;
        setSyncStatus('loading');
        try {
          const response = await fetch(`${targetUrl}?t=${Date.now()}`);
          const data = await response.json();
          if (data && data.status === 'success' && Array.isArray(data.sheets) && data.sheets.length > 0) {
            isRemoteUpdateRef.current = true;
            setSheets(data.sheets);
            if (data.activeSheetId) setActiveSheetId(data.activeSheetId);
            setLastSyncedAt(new Date());
            setSyncStatus('synced');
            if (!silent) showToast(`ซิงค์ข้อมูลจาก Google Sheets สำเร็จ (${data.sheets.length} เดือน)`);
          }
        } catch (err) {
          setSyncStatus('error');
          if (!silent) showToast('ไม่สามารถดึงข้อมูลจาก Google Sheets ได้');
        } finally {
          isInitialFetchedRef.current = true;
        }
      };

      const pushToGoogleSheet = async (targetUrl = gasUrl, sheetsData = sheets, activeId = activeSheetId) => {
        if (!targetUrl) return;
        setSyncStatus('saving');
        try {
          const response = await fetch(targetUrl, {
            method: 'POST',
            headers: { 'Content-Type': 'text/plain;charset=utf-8' },
            body: JSON.stringify({
              action: 'syncAll',
              email: cloudEmail,
              sheets: Array.isArray(sheetsData) ? sheetsData : [],
              activeSheetId: activeId || '',
            }),
          });
          const result = await response.json();
          if (result && result.status === 'success') {
            setLastSyncedAt(new Date());
            setSyncStatus('synced');
          }
        } catch (err) {
          setSyncStatus('error');
        }
      };

      useEffect(() => {
        if (gasUrl && isLoggedIn) fetchFromGoogleSheet(gasUrl, true);
      }, [isLoggedIn]);

      // Auto-save to Cloud & Google Sheet
      useEffect(() => {
        if (!isLoggedIn) return;
        if (isRemoteUpdateRef.current) {
          isRemoteUpdateRef.current = false;
          return;
        }
        const timer = setTimeout(async () => {
          const mods = window.__FIREBASE_MODULES__;
          if (mods && cloudUser && cloudDbRef.current && cloudEmail && isInitialFetchedRef.current) {
            try {
              setSyncStatus('saving');
              const docKey = `account_${normalizeEmailKey(cloudEmail)}`;
              const docRef = mods.doc(cloudDbRef.current, 'artifacts', currentAppId, 'public', 'data', 'user_budgets', docKey);
              const jsonStr = JSON.stringify(sheets);
              lastSavedHashRef.current = jsonStr;
              await mods.setDoc(docRef, {
                email: cloudEmail,
                sheetsJson: jsonStr,
                activeSheetId: activeSheetId,
                updatedAt: new Date().toISOString()
              });
              setLastSyncedAt(new Date());
              setSyncStatus('synced');
            } catch (e) {}
          }
          if (gasUrl) {
            pushToGoogleSheet(gasUrl, sheets, activeSheetId);
          }
        }, 900);
        return () => clearTimeout(timer);
      }, [sheets, activeSheetId, gasUrl, cloudUser, cloudEmail, isLoggedIn]);

      // ฟังก์ชันล็อกอินก่อนเข้าระบบ
      const handleLoginSubmit = async (e) => {
        e.preventDefault();
        const trimmedEmail = loginEmailInput.trim().toLowerCase();
        if (!trimmedEmail) return;

        // โหลดข้อมูลของอีเมลนั้นจาก LocalStorage ก่อนหากมี
        try {
          const savedForEmail = localStorage.getItem(getStorageKey(trimmedEmail));
          if (savedForEmail) {
            const parsed = JSON.parse(savedForEmail);
            if (Array.isArray(parsed) && parsed.length > 0) {
              setSheets(parsed);
            }
          }
        } catch (err) {}

        setCloudEmail(trimmedEmail);
        localStorage.setItem('monthly_expenses_cloud_email', trimmedEmail);

        const trimmedGas = loginGasInput.trim();
        if (trimmedGas) {
          setGasUrl(trimmedGas);
          localStorage.setItem('monthly_expenses_gas_url', trimmedGas);
        }

        setIsLoggedIn(true);
        showToast(`เข้าสู่ระบบและซิงค์ข้อมูลกับ "${trimmedEmail}" เรียบร้อยแล้ว`);
      };

      const handleLogout = () => {
        setIsLoggedIn(false);
        setLoginEmailInput(cloudEmail);
        setLoginGasInput(gasUrl);
      };

      const handleSaveCloudSettings = async (e) => {
        e.preventDefault();
        const trimmedEmail = inputCloudEmail.trim().toLowerCase();
        if (trimmedEmail) {
          setCloudEmail(trimmedEmail);
          localStorage.setItem('monthly_expenses_cloud_email', trimmedEmail);
          showToast(`ซิงค์ข้อมูลกับอีเมล "${trimmedEmail}" เรียบร้อยแล้ว`);
        }
        const trimmedUrl = inputGasUrl.trim();
        setGasUrl(trimmedUrl);
        if (trimmedUrl) {
          localStorage.setItem('monthly_expenses_gas_url', trimmedUrl);
          await fetchFromGoogleSheet(trimmedUrl, false);
        } else {
          localStorage.removeItem('monthly_expenses_gas_url');
        }
        setCloudModal(false);
      };

      const currentSheet = useMemo(() => {
        return sheets.find((s) => s.id === activeSheetId) || sheets[sheets.length - 1] || sheets[0];
      }, [sheets, activeSheetId]);

      const updateCurrentSheet = (updater) => {
        setSheets((prevSheets) =>
          prevSheets.map((sheet) => {
            if (sheet.id === currentSheet.id) {
              return typeof updater === 'function' ? updater(sheet) : { ...sheet, ...updater };
            }
            return sheet;
          })
        );
      };

      const totals = useMemo(() => computeSheetSummary(currentSheet), [currentSheet]);
      const monthlySummaries = useMemo(() => sheets.map((s) => ({ id: s.id, name: s.name, ...computeSheetSummary(s) })), [sheets]);

      const calcExpensePercentNum = (amount) => {
        const val = Number(amount) || 0;
        const base = expensePercentMode === 'income' ? totals.incomeTotal : totals.totalAllExpenses;
        if (!base || base <= 0) return 0;
        return (val / base) * 100;
      };

      const calcExpensePercent = (amount) => `${calcExpensePercentNum(amount).toFixed(2)}%`;

      const essentialLimitPct = currentSheet.essentialLimitPct !== undefined ? Number(currentSheet.essentialLimitPct) : 70;
      const investmentLimitPct = currentSheet.investmentLimitPct !== undefined ? Number(currentSheet.investmentLimitPct) : 20;

      const handleLimitPctChange = (field, value) => {
        const clamped = Math.max(0, Math.min(100, Number(value) || 0));
        updateCurrentSheet((sheet) => ({ ...sheet, [field]: clamped }));
      };

      const handleEssentialChange = (id, field, value) => {
        updateCurrentSheet((sheet) => ({
          ...sheet,
          essentialExpenses: (sheet.essentialExpenses || []).map((row) => (row.id === id ? { ...row, [field]: value } : row)),
        }));
      };

      const addEssentialRow = () => {
        const nextNo = (currentSheet.essentialExpenses || []).length + 1;
        updateCurrentSheet((sheet) => ({
          ...sheet,
          essentialExpenses: [...(sheet.essentialExpenses || []), { id: `e_${Date.now()}`, no: String(nextNo), item: '', detail: '', amount: 0, status: 'pending' }],
        }));
      };

      const deleteEssentialRow = (id) => {
        updateCurrentSheet((sheet) => ({
          ...sheet,
          essentialExpenses: (sheet.essentialExpenses || []).filter((r) => r.id !== id),
        }));
      };

      const handleInvestmentChange = (id, field, value) => {
        updateCurrentSheet((sheet) => ({
          ...sheet,
          investments: (sheet.investments || []).map((row) => (row.id === id ? { ...row, [field]: value } : row)),
        }));
      };

      const addInvestmentRow = () => {
        const nextNo = (currentSheet.investments || []).length + 1;
        updateCurrentSheet((sheet) => ({
          ...sheet,
          investments: [...(sheet.investments || []), { id: `i_${Date.now()}`, no: String(nextNo), item: '', detail: '', amount: 0, status: 'pending' }],
        }));
      };

      const deleteInvestmentRow = (id) => {
        updateCurrentSheet((sheet) => ({
          ...sheet,
          investments: (sheet.investments || []).filter((r) => r.id !== id),
        }));
      };

      const handleIncomeChange = (id, field, value) => {
        updateCurrentSheet((sheet) => ({
          ...sheet,
          incomes: (sheet.incomes || []).map((row) => (row.id === id ? { ...row, [field]: value } : row)),
        }));
      };

      const addIncomeRow = () => {
        const nextNo = (currentSheet.incomes || []).length + 1;
        updateCurrentSheet((sheet) => ({
          ...sheet,
          incomes: [...(sheet.incomes || []), { id: `inc_${Date.now()}`, no: String(nextNo), source: '', amount: 0 }],
        }));
      };

      const deleteIncomeRow = (id) => {
        updateCurrentSheet((sheet) => ({
          ...sheet,
          incomes: (sheet.incomes || []).filter((r) => r.id !== id),
        }));
      };

      const handleExtraExpenseChange = (id, field, value) => {
        updateCurrentSheet((sheet) => ({
          ...sheet,
          extraExpenses: (sheet.extraExpenses || []).map((row) => (row.id === id ? { ...row, [field]: value } : row)),
        }));
      };

      const addExtraExpenseRow = () => {
        const nextNo = (currentSheet.extraExpenses || []).length + 3;
        updateCurrentSheet((sheet) => ({
          ...sheet,
          extraExpenses: [...(sheet.extraExpenses || []), { id: `ext_${Date.now()}`, no: String(nextNo), item: '', amount: 0 }],
        }));
      };

      const deleteExtraExpenseRow = (id) => {
        updateCurrentSheet((sheet) => ({
          ...sheet,
          extraExpenses: (sheet.extraExpenses || []).filter((r) => r.id !== id),
        }));
      };

      const handleCreateNewMonth = (e) => {
        e.preventDefault();
        if (!newMonthName.trim()) return;
        const newId = `sheet_${Date.now()}`;
        const baseData = copyFromCurrent ? currentSheet : DEFAULT_SHEET_DATA;
        const newSheet = {
          ...JSON.parse(JSON.stringify(baseData)),
          id: newId,
          name: newMonthName.trim(),
        };
        setSheets((prev) => [...prev, newSheet]);
        setActiveSheetId(newId);
        setNewMonthName('');
        setNewMonthModal(false);
        showToast(`สร้างงบเดือน "${newSheet.name}" เรียบร้อยแล้ว`);
      };

      const handleRenameMonth = (e) => {
        e.preventDefault();
        if (!editMonthModal || !editMonthModal.name.trim()) return;
        const updatedName = editMonthModal.name.trim();
        setSheets((prev) => prev.map((s) => (s.id === editMonthModal.id ? { ...s, name: updatedName } : s)));
        setEditMonthModal(null);
        showToast(`เปลี่ยนชื่อเดือนเป็น "${updatedName}" เรียบร้อยแล้ว`);
      };

      const handleDeleteMonthById = (targetId) => {
        const target = sheets.find((s) => s.id === targetId);
        if (!target) return;
        if (sheets.length <= 1) {
          const resetSheet = { ...JSON.parse(JSON.stringify(DEFAULT_SHEET_DATA)), id: `sheet_${Date.now()}` };
          setSheets([resetSheet]);
          setActiveSheetId(resetSheet.id);
          setDeleteMonthModal(null);
          showToast('รีเซ็ตเป็นเดือนเริ่มต้นเรียบร้อยแล้ว');
          return;
        }
        const remaining = sheets.filter((s) => s.id !== targetId);
        setSheets(remaining);
        if (activeSheetId === targetId) setActiveSheetId(remaining[remaining.length - 1].id);
        setDeleteMonthModal(null);
        showToast(`ลบเดือน "${target.name}" เรียบร้อยแล้ว`);
      };

      const handleExportCSV = () => {
        const rows = [
          ['สรุปรายรับ-รายจ่าย:', currentSheet.name, 'บัญชี:', cloudEmail],
          [],
          ['--- 1. รายจ่ายจำเป็น ---'],
          ['ลำดับ', 'รายการ', 'รายละเอียด', 'จำนวนเงิน', 'สถานะ'],
          ...(currentSheet.essentialExpenses || []).map((r) => [r.no, r.item, r.detail, r.amount, migrateRowStatus(r) === 'paid' ? 'จ่ายแล้ว' : 'รอจ่าย']),
          ['', 'รวมรายจ่ายจำเป็น', '', totals.essentialTotal],
          [],
          ['--- 2. เงินลงทุน ---'],
          ['ลำดับ', 'รายการ', 'รายละเอียด', 'งบลงทุน', 'สถานะ'],
          ...(currentSheet.investments || []).map((r) => [r.no, r.item, r.detail, r.amount, migrateRowStatus(r) === 'paid' ? 'จ่ายแล้ว' : 'รอจ่าย']),
          ['', 'รวมเงินลงทุน', '', totals.investmentTotal],
          [],
          ['--- 3. รวมรายได้ของเดือนนี้ ---'],
          ['ลำดับ', 'แหล่งรายได้', 'จำนวนเงิน'],
          ...(currentSheet.incomes || []).map((r) => [r.no, r.source, r.amount]),
          ['', 'รายได้รวมทั้งหมด', totals.incomeTotal],
          [],
          ['--- 4. รวมรายจ่ายของเดือนนี้ ---'],
          ['1', 'ค่าใช้จ่ายจำเป็น', totals.essentialTotal],
          ['2', 'ลงทุน , เงินเก็บ', totals.investmentTotal],
          ...(currentSheet.extraExpenses || []).map((r) => [r.no, r.item, r.amount]),
          ['', 'รายจ่ายรวมทั้งหมด', totals.totalAllExpenses],
          ['', 'คงเหลือสุทธิ (TOTAL)', totals.netRemaining],
        ];
        const csvContent = '\uFEFF' + rows.map((e) => e.map((c) => `"${String(c ?? '').replace(/"/g, '""')}"`).join(',')).join('\n');
        const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
        const url = URL.createObjectURL(blob);
        const link = document.createElement('a');
        link.href = url;
        link.setAttribute('download', `Monthly_expenses_${currentSheet.name}.csv`);
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
      };

      const filteredEssential = useMemo(() => {
        return (currentSheet.essentialExpenses || []).filter((row) => {
          if (hideZeroRows && (!row.amount || Number(row.amount) === 0)) return false;
          if (!searchQuery.trim()) return true;
          const q = searchQuery.toLowerCase();
          return (row.item || '').toLowerCase().includes(q) || (row.detail || '').toLowerCase().includes(q);
        });
      }, [currentSheet.essentialExpenses, hideZeroRows, searchQuery]);

      const filteredInvestments = useMemo(() => {
        return (currentSheet.investments || []).filter((row) => {
          if (hideZeroRows && (!row.amount || Number(row.amount) === 0)) return false;
          if (!searchQuery.trim()) return true;
          const q = searchQuery.toLowerCase();
          return (row.item || '').toLowerCase().includes(q) || (row.detail || '').toLowerCase().includes(q);
        });
      }, [currentSheet.investments, hideZeroRows, searchQuery]);

      const filteredIncomes = useMemo(() => {
        return (currentSheet.incomes || []).filter((row) => {
          if (hideZeroRows && (!row.amount || Number(row.amount) === 0)) return false;
          if (!searchQuery.trim()) return true;
          const q = searchQuery.toLowerCase();
          return (row.source || '').toLowerCase().includes(q);
        });
      }, [currentSheet.incomes, hideZeroRows, searchQuery]);

      const filteredExtraExpenses = useMemo(() => {
        return (currentSheet.extraExpenses || []).filter((row) => {
          if (hideZeroRows && (!row.amount || Number(row.amount) === 0)) return false;
          if (!searchQuery.trim()) return true;
          const q = searchQuery.toLowerCase();
          return (row.item || '').toLowerCase().includes(q);
        });
      }, [currentSheet.extraExpenses, hideZeroRows, searchQuery]);

      // ============================================================================
      // หน้าล็อกอินด้วยอีเมลก่อนเข้าใช้งาน (Email Login Gate)
      // ============================================================================
      if (!isLoggedIn) {
        return (
          <div className="min-h-screen bg-[#080C14] text-slate-100 flex items-center justify-center p-4 relative overflow-hidden">
            <div className="pointer-events-none fixed top-1/4 left-1/4 w-[480px] h-[320px] bg-blue-600/15 blur-[130px] rounded-full" />
            <div className="pointer-events-none fixed bottom-1/4 right-1/4 w-[420px] h-[300px] bg-emerald-600/10 blur-[140px] rounded-full" />

            <div className="w-full max-w-md bg-[#111827]/95 backdrop-blur-xl border border-slate-800 rounded-3xl p-6 sm:p-8 shadow-2xl relative z-10 space-y-6">
              <div className="flex flex-col items-center text-center space-y-3">
                <div className="w-14 h-14 rounded-2xl bg-gradient-to-br from-blue-500 to-blue-700 flex items-center justify-center text-white shadow-xl shadow-blue-600/30 border border-blue-400/30">
                  <IconSparkles className="w-7 h-7" />
                </div>
                <div>
                  <span className="text-[11px] font-semibold bg-blue-500/15 text-blue-400 border border-blue-500/30 px-3 py-0.5 rounded-full">
                    Cloud Auto-Sync • Financial SaaS
                  </span>
                  <h1 className="text-2xl font-extrabold text-white mt-2 tracking-tight">
                    เข้าสู่ระบบจัดการงบรายเดือน
                  </h1>
                  <p className="text-xs text-slate-400 mt-1">
                    กรอกอีเมลของคุณเพื่อซิงค์ข้อมูลรายรับ-รายจ่ายอัตโนมัติ เปิดในคอมหรือมือถือเครื่องไหนข้อมูลก็อัปเดตตรงกันทันที
                  </p>
                </div>
              </div>

              <form onSubmit={handleLoginSubmit} className="space-y-4">
                <div className="space-y-2">
                  <label className="block text-xs font-semibold text-slate-300">
                    อีเมลสำหรับซิงค์ข้อมูลของคุณ (Email Address)
                  </label>
                  <div className="relative">
                    <div className="absolute left-3.5 top-1/2 -translate-y-1/2 text-blue-400">
                      <IconMail className="w-5 h-5" />
                    </div>
                    <input
                      type="email"
                      required
                      placeholder="yourname@gmail.com"
                      value={loginEmailInput}
                      onChange={(e) => setLoginEmailInput(e.target.value)}
                      className="w-full pl-11 pr-4 py-3 bg-[#090D16] border border-slate-700 rounded-xl text-sm text-white placeholder:text-slate-500 focus:outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 font-mono"
                    />
                  </div>
                </div>

                <div>
                  <button
                    type="button"
                    onClick={() => setShowAdvancedGas(!showAdvancedGas)}
                    className="text-[11px] text-slate-400 hover:text-blue-400 transition cursor-pointer flex items-center gap-1"
                  >
                    <span>{showAdvancedGas ? '▼ ซ่อนตั้งค่า Google Sheets เสริม' : '▶ ตั้งค่าเชื่อม Google Sheets Web App URL (เสริม - ไม่บังคับ)'}</span>
                  </button>

                  {showAdvancedGas && (
                    <div className="mt-2 p-3 bg-[#090D16]/80 rounded-xl border border-slate-800 space-y-1.5">
                      <label className="block text-[11px] text-slate-400">Google Apps Script URL (ลงท้ายด้วย /exec)</label>
                      <input
                        type="url"
                        placeholder="https://script.google.com/macros/s/.../exec"
                        value={loginGasInput}
                        onChange={(e) => setLoginGasInput(e.target.value)}
