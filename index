                                onChange={(e) => handleIncomeChange(row.id, 'source', e.target.value)}
                                className="w-full px-2 py-1 rounded-lg bg-transparent text-slate-100 placeholder:text-slate-600 focus:bg-[#090D16] focus:outline-none focus:ring-1 focus:ring-blue-500 text-sm"
                              />
                            </td>
                            <td className="py-2 px-2 text-right font-mono text-xs text-blue-400 font-medium">
                              {pctNum.toFixed(2)}%
                            </td>
                            <td className="py-2 px-1.5">
                              <EditableNumberCell
                                value={row.amount}
                                onChange={(val) => handleIncomeChange(row.id, 'amount', val)}
                              />
                            </td>
                            <td className="py-2 px-2 text-center">
                              <button
                                type="button"
                                onClick={() => deleteIncomeRow(row.id)}
                                className="p-1.5 rounded-lg text-slate-600 hover:text-rose-400 hover:bg-rose-950/40 transition cursor-pointer"
                              >
                                <Trash2 className="w-3.5 h-3.5" />
                              </button>
                            </td>
                          </tr>
                        );
                      })}
                    </tbody>
                  </table>
                </div>

                <div className="mt-auto p-4 bg-[#0B0F19] border-t border-slate-800/90 flex items-center justify-between">
                  <span className="text-xs font-semibold uppercase tracking-wider text-slate-400">รวมรายได้ทั้งหมด</span>
                  <div className="text-lg font-bold font-mono text-emerald-400">฿{formatCurrency(totals.incomeTotal)}</div>
                </div>
              </section>

              {/* 4. รวมรายจ่ายของเดือนนี้ (ไม่มีหลอดพลัง) */}
              <section className="bg-[#111827]/95 border border-slate-800/90 rounded-2xl shadow-xl overflow-hidden flex flex-col">
                <div className="p-5 border-b border-slate-800/90 flex flex-wrap items-center justify-between gap-2 bg-gradient-to-r from-rose-950/30 via-transparent to-transparent">
                  <div className="flex items-center gap-3">
                    <div className="w-9 h-9 rounded-xl bg-rose-500/15 border border-rose-500/30 flex items-center justify-center text-rose-400">
                      <CreditCard className="w-4 h-4" />
                    </div>
                    <div>
                      <div className="flex flex-wrap items-center gap-2">
                        <h2 className="text-base font-bold text-white">4. รวมรายจ่ายของเดือนนี้</h2>
                        <button
                          type="button"
                          onClick={() => setExpensePercentMode(expensePercentMode === 'income' ? 'expense' : 'income')}
                          className="text-[11px] bg-blue-500/15 text-blue-300 border border-blue-500/30 px-2 py-0.5 rounded-full hover:bg-blue-500/25 transition cursor-pointer"
                        >
                          % เทียบ{expensePercentMode === 'income' ? 'รายได้รวม' : 'รายจ่ายรวม'}
                        </button>
                      </div>
                      <p className="text-xs text-slate-400">ซิงค์ยอดรายจ่ายจำเป็น + เงินลงทุนอัตโนมัติ และเพิ่มรายจ่ายเสริมได้</p>
                    </div>
                  </div>
                  <button
                    type="button"
                    onClick={addExtraExpenseRow}
                    className="px-3 py-1.5 rounded-xl text-xs font-semibold bg-blue-600 hover:bg-blue-500 text-white shadow-md shadow-blue-600/20 flex items-center gap-1 transition cursor-pointer shrink-0"
                  >
                    <Plus className="w-3.5 h-3.5" /> เพิ่มรายจ่ายเสริม
                  </button>
                </div>

                <div className="overflow-x-auto">
                  <table className="w-full text-left border-collapse">
                    <thead>
                      <tr className="border-b border-slate-800/80 text-[11px] font-semibold uppercase tracking-wider text-slate-400 bg-[#0B0F19]/60">
                        <th className="py-2.5 px-2 w-10 text-center">#</th>
                        <th className="py-2.5 px-2">หมวดหมู่รายจ่าย</th>
                        <th className="py-2.5 px-2 w-28 text-right">สัดส่วน (%)</th>
                        <th className="py-2.5 px-2 w-36 text-right">จำนวนเงิน (฿)</th>
                        <th className="py-2.5 px-2 w-12 text-center">ลบ</th>
                      </tr>
                    </thead>
                    <tbody className="divide-y divide-slate-800/60 text-sm">
                      <tr className="bg-blue-950/15">
                        <td className="py-2.5 px-2 text-center font-mono text-xs text-blue-400">1</td>
                        <td className="py-2.5 px-2">
                          <div className="flex items-center gap-2">
                            <span className="font-medium text-slate-100">ค่าใช้จ่ายจำเป็น</span>
                            <span className="inline-flex items-center gap-1 text-[10px] bg-blue-500/15 text-blue-400 border border-blue-500/30 px-1.5 py-0.5 rounded-md">
                              <Link2 className="w-2.5 h-2.5" /> Auto-Sync
                            </span>
                          </div>
                        </td>
                        <td className="py-2.5 px-2 text-right font-mono text-xs text-rose-400 font-semibold">
                          {calcExpensePercent(totals.essentialTotal)}
                        </td>
                        <td className="py-2.5 px-4 text-right font-mono text-sm font-semibold text-slate-100">
                          {formatCurrency(totals.essentialTotal)}
                        </td>
                        <td className="py-2.5 px-2 text-center text-xs text-slate-600">—</td>
                      </tr>

                      <tr className="bg-cyan-950/15">
                        <td className="py-2.5 px-2 text-center font-mono text-xs text-cyan-400">2</td>
                        <td className="py-2.5 px-2">
                          <div className="flex items-center gap-2">
                            <span className="font-medium text-slate-100">ลงทุน , เงินเก็บ</span>
                            <span className="inline-flex items-center gap-1 text-[10px] bg-cyan-500/15 text-cyan-400 border border-cyan-500/30 px-1.5 py-0.5 rounded-md">
                              <Link2 className="w-2.5 h-2.5" /> Auto-Sync
                            </span>
                          </div>
                        </td>
                        <td className="py-2.5 px-2 text-right font-mono text-xs text-cyan-400 font-semibold">
                          {calcExpensePercent(totals.investmentTotal)}
                        </td>
                        <td className="py-2.5 px-4 text-right font-mono text-sm font-semibold text-cyan-300">
                          {formatCurrency(totals.investmentTotal)}
                        </td>
                        <td className="py-2.5 px-2 text-center text-xs text-slate-600">—</td>
                      </tr>

                      {filteredExtraExpenses.map((row) => (
                        <tr key={row.id} className="hover:bg-slate-800/30 transition-colors">
                          <td className="py-2 px-1.5 text-center">
                            <input
                              type="text"
                              value={row.no}
                              onChange={(e) => handleExtraExpenseChange(row.id, 'no', e.target.value)}
                              className="w-full text-center bg-transparent text-xs font-mono text-slate-500 focus:text-white focus:outline-none"
                            />
                          </td>
                          <td className="py-2 px-1.5">
                            <input
                              type="text"
                              value={row.item}
                              placeholder="รายการรายจ่ายเสริม..."
                              onChange={(e) => handleExtraExpenseChange(row.id, 'item', e.target.value)}
                              className="w-full px-2 py-1 rounded-lg bg-transparent text-slate-100 placeholder:text-slate-600 focus:bg-[#090D16] focus:outline-none focus:ring-1 focus:ring-blue-500 text-sm"
                            />
                          </td>
                          <td className="py-2 px-2 text-right font-mono text-xs text-rose-300">
                            {calcExpensePercent(row.amount)}
                          </td>
                          <td className="py-2 px-1.5">
                            <EditableNumberCell
                              value={row.amount}
                              onChange={(val) => handleExtraExpenseChange(row.id, 'amount', val)}
                            />
                          </td>
                          <td className="py-2 px-2 text-center">
                            <button
                              type="button"
                              onClick={() => deleteExtraExpenseRow(row.id)}
                              className="p-1.5 rounded-lg text-slate-600 hover:text-rose-400 hover:bg-rose-950/40 transition cursor-pointer"
                            >
                              <Trash2 className="w-3.5 h-3.5" />
                            </button>
                          </td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>

                <div className="mt-auto p-4 bg-[#0B0F19] border-t border-slate-800/90 flex items-center justify-between">
                  <span className="text-xs font-semibold uppercase tracking-wider text-slate-400">รวมรายจ่ายทั้งหมด</span>
                  <div className="text-lg font-bold font-mono text-rose-400">฿{formatCurrency(totals.totalAllExpenses)}</div>
                </div>
              </section>
            </div>

            {/* Bottom Total Remaining Banner */}
            <div
              className={`rounded-2xl p-6 sm:p-8 border shadow-2xl relative overflow-hidden transition-all ${
                totals.netRemaining >= 0
                  ? 'bg-gradient-to-r from-[#0F172A] via-[#111827] to-blue-950/60 border-blue-500/40'
                  : 'bg-gradient-to-r from-[#0F172A] via-[#111827] to-rose-950/50 border-rose-500/40'
              }`}
            >
              <div className="relative z-10 flex flex-col md:flex-row items-center justify-between gap-6">
                <div className="space-y-1.5 text-center md:text-left">
                  <div className="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-500/10 border border-blue-500/30 text-blue-400 text-xs font-semibold">
                    <Sparkles className="w-3.5 h-3.5" />
                    สรุปยอดเงินคงเหลือสุทธิประจำเดือน ({currentSheet.name})
                  </div>
                  <h3 className="text-2xl sm:text-3xl font-extrabold text-white tracking-tight">
                    TOTAL เงินคงเหลือทั้งหมด
                  </h3>
                  <p className="text-xs sm:text-sm text-slate-400">
                    คำนวณอัตโนมัติจาก{' '}
                    <span className="text-emerald-400 font-mono font-semibold">
                      รายได้รวม (฿{formatCurrency(totals.incomeTotal)})
                    </span>{' '}
                    หักลบด้วย{' '}
                    <span className="text-rose-400 font-mono font-semibold">
                      รายจ่ายรวม (฿{formatCurrency(totals.totalAllExpenses)})
                    </span>
                  </p>
                </div>

                <div className="flex flex-col items-center md:items-end">
                  <div
                    className={`text-3xl sm:text-4xl font-extrabold font-mono tracking-tight px-6 py-3 rounded-2xl border ${
                      totals.netRemaining >= 0
                        ? 'bg-blue-600/15 border-blue-500/40 text-blue-400 shadow-lg shadow-blue-600/10'
                        : 'bg-rose-500/15 border-rose-500/40 text-rose-400 shadow-lg shadow-rose-600/10'
                    }`}
                  >
                    {totals.netRemaining > 0 ? '+' : ''}฿{formatCurrency(totals.netRemaining)}
                  </div>
                </div>
              </div>
            </div>
          </>
        ) : (
          /* Analytics Page */
          <div className="space-y-8">
            <div className="space-y-5">
              <div className="bg-gradient-to-r from-blue-950/40 via-[#111827]/95 to-[#111827]/95 border border-blue-500/30 rounded-2xl p-6 flex flex-col sm:flex-row sm:items-center justify-between gap-4 shadow-xl">
                <div>
                  <div className="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-500/15 border border-blue-500/30 text-blue-400 text-xs font-semibold mb-2">
                    <BarChart3 className="w-3.5 h-3.5" />
                    หัวข้อหลัก • Main Financial Summary
                  </div>
                  <h2 className="text-xl sm:text-2xl font-extrabold text-white tracking-tight">
                    รายรับรายจ่ายเงินคงเหลือทั้งหมด
                  </h2>
                  <p className="text-xs sm:text-sm text-slate-400 mt-1">
                    สรุปภาพรวมรายรับ รายจ่ายทั้งหมด และยอดเงินคงเหลือสุทธิของทุกเดือน พร้อมจัดการแก้ไขหรือลบเดือนย้อนหลังได้ทันที
                  </p>
                </div>
                <button
                  type="button"
                  onClick={() => setNewMonthModal(true)}
                  className="px-4 py-2.5 rounded-xl text-xs sm:text-sm font-semibold bg-blue-600 hover:bg-blue-500 text-white shadow-lg shadow-blue-600/25 flex items-center gap-1.5 transition cursor-pointer shrink-0"
                >
                  <FolderPlus className="w-4 h-4" />
                  <span>+ เพิ่มเดือนใหม่</span>
                </button>
              </div>

              <div className="grid grid-cols-1 lg:grid-cols-3 gap-6">
                {monthlySummaries.map((m) => (
                  <div key={m.id} className="bg-[#111827]/95 border border-slate-800/90 rounded-2xl p-5 space-y-3">
                    <div className="flex items-center justify-between">
                      <span className="font-bold text-white">{m.name}</span>
                      <div className="flex items-center gap-1">
                        <button
                          type="button"
                          onClick={() => {
                            setActiveSheetId(m.id);
                            setActivePage('workspace');
                          }}
                          className="px-2.5 py-1 rounded-lg text-xs font-semibold bg-blue-600 text-white cursor-pointer"
                        >
                          แก้ข้อมูล
                        </button>
                        <button
                          type="button"
                          onClick={() => setEditMonthModal({ id: m.id, name: m.name })}
                          className="p-1.5 rounded-lg bg-[#090D16] text-slate-300 hover:text-blue-400 border border-slate-800 cursor-pointer"
                        >
                          <Edit3 className="w-3.5 h-3.5" />
                        </button>
                        <button
                          type="button"
                          onClick={() => setDeleteMonthModal({ id: m.id, name: m.name })}
                          className="p-1.5 rounded-lg bg-[#090D16] text-slate-400 hover:text-rose-400 border border-slate-800 cursor-pointer"
                        >
                          <Trash2 className="w-3.5 h-3.5" />
                        </button>
                      </div>
                    </div>
                    <div className="text-xs font-mono space-y-1 text-slate-300">
                      <div className="flex justify-between"><span>3. รวมรายได้:</span><span className="text-emerald-400">฿{formatCurrency(m.incomeTotal)}</span></div>
                      <div className="flex justify-between"><span>1. รายจ่ายจำเป็น:</span><span className="text-rose-400">฿{formatCurrency(m.essentialTotal)}</span></div>
                      <div className="flex justify-between"><span>2. เงินลงทุน:</span><span className="text-cyan-400">฿{formatCurrency(m.investmentTotal)}</span></div>
                      <div className="flex justify-between border-t border-slate-800 pt-1 font-bold"><span>คงเหลือสุทธิ:</span><span className={m.netRemaining >= 0 ? 'text-blue-400' : 'text-rose-400'}>฿{formatCurrency(m.netRemaining)}</span></div>
                    </div>
                  </div>
                ))}
              </div>
            </div>
          </div>
        )}
      </main>

      {/* Modal ล็อกอินอีเมลซิงค์ Cloud อัตโนมัติ */}
      {cloudModal && (
        <div className="fixed inset-0 z-50 bg-black/70 backdrop-blur-sm flex items-center justify-center p-4">
          <div className="bg-[#111827] rounded-2xl max-w-lg w-full p-6 shadow-2xl border border-emerald-500/30">
            <div className="flex items-center justify-between mb-3">
              <div className="flex items-center gap-3 text-emerald-400">
                <div className="w-10 h-10 rounded-xl bg-emerald-600/20 border border-emerald-500/30 flex items-center justify-center">
                  <Cloud className="w-5 h-5" />
                </div>
                <div>
                  <h3 className="text-base font-bold text-white">ล็อกอินอีเมลซิงค์ Cloud อัตโนมัติ</h3>
                  <p className="text-xs text-slate-400">เปิดจากคอมเครื่องไหนข้อมูลก็อัปเดตล่าสุดตรงกันทันที</p>
                </div>
              </div>
              {lastSyncedAt && (
                <span className="text-[11px] font-mono text-emerald-400 bg-emerald-500/10 border border-emerald-500/30 px-2.5 py-1 rounded-full">
                  ซิงค์ล่าสุด: {lastSyncedAt.toLocaleTimeString('th-TH')}
                </span>
              )}
            </div>

            <form onSubmit={handleSaveCloudSettings} className="space-y-4">
              <div className="bg-[#090D16] p-4 rounded-xl border border-emerald-500/30 space-y-2.5">
                <label className="block text-xs font-bold text-emerald-300">
                  1. อีเมลของคุณ หรือ รหัสซิงค์ส่วนตัว (Auto-Sync ทันทีโดยไม่ต้องตั้งค่าเพิ่ม)
                </label>
                <input
                  type="text"
                  required
                  placeholder="เช่น yourname@gmail.com"
                  value={inputCloudEmail}
                  onChange={(e) => setInputCloudEmail(e.target.value)}
                  className="w-full px-3.5 py-2.5 bg-[#111827] border border-slate-700 rounded-xl text-sm text-white focus:outline-none focus:border-emerald-500 font-mono"
                />
                <p className="text-[11px] text-slate-400 leading-relaxed">
                  💡 เพียงใส่อีเมลเดียวกันนี้เวลาเปิดในคอมเครื่องอื่น ข้อมูลทั้ง 4 หัวข้อและทุกเดือนจะซิงค์อัปเดตล่าสุดให้ตรงกันโดยอัตโนมัติ
                </p>
              </div>

              <div className="bg-[#090D16]/70 p-4 rounded-xl border border-slate-800 space-y-2">
                <label className="block text-xs font-semibold text-slate-300">
                  2. Google Apps Script Web App URL (เสริม - ไม่บังคับ)
                </label>
                <div className="relative">
                  <Key className="w-4 h-4 text-slate-500 absolute left-3 top-1/2 -translate-y-1/2" />
                  <input
                    type="url"
                    placeholder="https://script.google.com/macros/s/AKfycb.../exec"
                    value={inputGasUrl}
                    onChange={(e) => setInputGasUrl(e.target.value)}
                    className="w-full pl-9 pr-3.5 py-2 bg-[#111827] border border-slate-800 rounded-xl text-xs text-slate-200 focus:outline-none focus:border-blue-500 font-mono"
                  />
                </div>
              </div>

              <div className="flex items-center justify-end gap-2 pt-2 border-t border-slate-800">
                <button
                  type="button"
                  onClick={() => setCloudModal(false)}
                  className="px-4 py-2 text-xs font-medium text-slate-400 hover:text-white rounded-xl cursor-pointer"
                >
                  ปิด
                </button>
                <button
                  type="submit"
                  className="px-4 py-2 text-xs font-semibold bg-emerald-600 hover:bg-emerald-500 text-white rounded-xl cursor-pointer"
                >
                  บันทึก & ซิงค์อัตโนมัติ
                </button>
              </div>
            </form>
          </div>
        </div>
      )}
    </div>
  );
}
