const GAS_CODE_TEMPLATE = `var SHEET_MONTHS = 'DB_Months';
var SHEET_CONFIG = 'DB_Config';

function initDatabase() {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var monthSheet = ss.getSheetByName(SHEET_MONTHS);
  if (!monthSheet) {
    monthSheet = ss.insertSheet(SHEET_MONTHS);
    var headers = ['month_id','month_name','income_total','essential_total','investment_total','extra_total','net_remaining','updated_at','raw_json'];
    monthSheet.getRange(1, 1, 1, headers.length).setValues([headers]);
    monthSheet.setFrozenRows(1);
  }
  var configSheet = ss.getSheetByName(SHEET_CONFIG);
  if (!configSheet) {
    configSheet = ss.insertSheet(SHEET_CONFIG);
    configSheet.getRange(1, 1, 1, 3).setValues([['config_key', 'config_value', 'updated_at']]);
    configSheet.setFrozenRows(1);
  }
  return { ss: ss, monthSheet: monthSheet, configSheet: configSheet };
}

function doGet(e) {
  try {
    var db = initDatabase();
    var lastRow = db.monthSheet.getLastRow();
    var sheets = [];
    if (lastRow > 1) {
      var values = db.monthSheet.getRange(2, 1, lastRow - 1, 9).getValues();
      for (var i = 0; i < values.length; i++) {
        if (values[i][8]) {
          try { sheets.push(JSON.parse(values[i][8])); } catch (err) {}
        }
      }
    }
    var activeSheetId = '';
    var configLastRow = db.configSheet.getLastRow();
    if (configLastRow > 1) {
      var configVals = db.configSheet.getRange(2, 1, db.configSheet.getLastRow() - 1, 2).getValues();
      for (var j = 0; j < configVals.length; j++) {
        if (configVals[j][0] === 'activeSheetId') { activeSheetId = configVals[j][1]; break; }
      }
    }
    return ContentService.createTextOutput(JSON.stringify({
      status: 'success', sheets: sheets, activeSheetId: activeSheetId, serverTime: new Date().toISOString()
    })).setMimeType(ContentService.MimeType.JSON);
  } catch (error) {
    return ContentService.createTextOutput(JSON.stringify({ status: 'error', message: error.toString() }))
      .setMimeType(ContentService.MimeType.JSON);
  }
}

function doPost(e) {
  try {
    var db = initDatabase();
    var rawBody = e && e.postData && e.postData.contents ? e.postData.contents : '';
    if (!rawBody) {
      return ContentService.createTextOutput(JSON.stringify({ status: 'error', message: 'No data' })).setMimeType(ContentService.MimeType.JSON);
    }
    var payload = JSON.parse(rawBody);
    var sheets = Array.isArray(payload.sheets) ? payload.sheets : [];
    var activeSheetId = payload.activeSheetId || (sheets[0] ? sheets[0].id : '');
    var now = new Date().toLocaleString('th-TH', { timeZone: 'Asia/Bangkok' });

    var rowsToWrite = sheets.map(function(sheet) {
      var essentialTotal = (sheet.essentialExpenses || []).reduce(function(s, r) { return s + (Number(r.amount) || 0); }, 0);
      var investmentTotal = (sheet.investments || []).reduce(function(s, r) { return s + (Number(r.amount) || 0); }, 0);
      var incomeTotal = (sheet.incomes || []).reduce(function(s, r) { return s + (Number(r.amount) || 0); }, 0);
      var extraTotal = (sheet.extraExpenses || []).reduce(function(s, r) { return s + (Number(r.amount) || 0); }, 0);
      var netRemaining = incomeTotal - (essentialTotal + investmentTotal + extraTotal);
      return [sheet.id || '', sheet.name || '', incomeTotal, essentialTotal, investmentTotal, extraTotal, netRemaining, now, JSON.stringify(sheet)];
    });

    var currentLastRow = db.monthSheet.getLastRow();
    if (currentLastRow > 1) {
      db.monthSheet.getRange(2, 1, currentLastRow - 1, 9).clearContent();
    }
    if (rowsToWrite.length > 0) {
      db.monthSheet.getRange(2, 1, rowsToWrite.length, 9).setValues(rowsToWrite);
    }
    if (db.configSheet.getLastRow() > 1) {
      db.configSheet.getRange(2, 1, db.configSheet.getLastRow() - 1, 3).clearContent();
    }
    db.configSheet.getRange(2, 1, 1, 3).setValues([['activeSheetId', activeSheetId, now]]);

    return ContentService.createTextOutput(JSON.stringify({
      status: 'success', savedCount: rowsToWrite.length, updatedAt: now
    })).setMimeType(ContentService.MimeType.JSON);
  } catch (error) {
    return ContentService.createTextOutput(JSON.stringify({ status: 'error', message: error.toString() }))
      .setMimeType(ContentService.MimeType.JSON);
  }
}`;

