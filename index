          if (data.activeSheetId) {
            setActiveSheetId(data.activeSheetId);
          }
          setLastSyncedAt(new Date());
          setSyncStatus('synced');
          if (!silent) showToast(`ดึงข้อมูลจาก Google Sheets สำเร็จ (${normalized.length} เดือน)`);
        } else {
          await pushToGoogleSheet(targetUrl, sheets, activeSheetId, true);
          if (!silent) showToast('เชื่อมต่อสำเร็จ! อัปโหลดข้อมูลเริ่มต้นขึ้น Google Sheets แล้ว');
        }
      } else {
        throw new Error(data?.message || 'Invalid response');
      }
    } catch (err) {
      console.error('Google Sheet Fetch Error:', err);
      setSyncStatus('error');
      if (!silent) showToast('ไม่สามารถดึงข้อมูลจาก Google Sheets ได้ กรุณาตรวจสอบ Web App URL');
    } finally {
      isInitialFetchedRef.current = true;
    }
  };

  const pushToGoogleSheet = async (targetUrl = gasUrl, sheetsData = sheets, activeId = activeSheetId, silent = true) => {
    if (!targetUrl) return;
    setSyncStatus('saving');
    try {
      // Ensure safe array payload
      const safeSheets = Array.isArray(sheetsData) ? sheetsData : [];
      const response = await fetch(targetUrl, {
        method: 'POST',
        redirect: 'follow',
        headers: {
          'Content-Type': 'text/plain;charset=utf-8',
        },
        body: JSON.stringify({
          action: 'syncAll',
          sheets: safeSheets,
          activeSheetId: activeId || '',
        }),
      });
      const result = await response.json();
      if (result && result.status === 'success') {
        setLastSyncedAt(new Date());
        setSyncStatus('synced');
        if (!silent) showToast('บันทึกข้อมูลลง Google Sheets เรียบร้อยแล้ว');
      } else {
        throw new Error(result?.message || 'Save failed');
      }
    } catch (err) {
      console.error('Google Sheet Save Error:', err);
      setSyncStatus('error');
      if (!silent) showToast('บันทึกลง Google Sheets ไม่สำเร็จ');
    }
  };

  useEffect(() => {
    if (gasUrl) {
      fetchFromGoogleSheet(gasUrl, true);
    } else if (!cloudDb) {
      isInitialFetchedRef.current = true;
    }
  }, []);

  // 3. บันทึกอัตโนมัติ (Auto-Save) ขึ้น Cloud และ Google Sheet ทุกครั้งที่แก้ไข
