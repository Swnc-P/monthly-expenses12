            investments: (sh.investments || []).map(r => ({ ...r, status: migrateRowStatus(r) }))
          }));
          setSheets(normalized);
          if (data.activeSheetId) {
            setActiveSheetId(data.activeSheetId);
          }
          setLastSyncedAt(new Date());
          setSyncStatus('synced');
          isInitialFetchedRef.current = true;
          if (!silent) showToast(`ดึงข้อมูลล่าสุดจาก Cloud สำเร็จ (${normalized.length} เดือน)`);
          return true;
        } else {
          setLastSyncedAt(new Date());
          setSyncStatus('idle');
          isInitialFetchedRef.current = true;
          if (!silent) showToast('เชื่อมต่อสำเร็จ (ยังไม่มีข้อมูลบน Google Sheets)');
          return true;
        }
      } else {
        throw new Error(data?.message || 'Invalid response');
      }
    } catch (err) {
      console.error('Google Sheet Fetch Error:', err);
      setSyncStatus('error');
      if (!silent) showToast('ไม่สามารถดึงข้อมูลได้ กรุณาตรวจสอบลิงก์ /exec และสิทธิ์ Anyone');
      return false;
    }
  };

  const pushToGoogleSheet = async (targetUrl = gasUrl, sheetsData = sheets, activeId = activeSheetId, silent = true) => {
    if (!targetUrl) return;
    setSyncStatus('saving');
    try {
      const safeSheets = Array.isArray(sheetsData) ? sheetsData : [];
      const response = await fetch(targetUrl, {
        method: 'POST',
        redirect: 'follow',
        headers: {
          'Content-Type': 'text/plain;charset=utf-8',
        },
        body: JSON.stringify({
          action: 'syncAll',
          sheets: safeSheets,
          activeSheetId: activeId || '',
        }),
      });
      const result = await response.json();
      if (result && result.status === 'success') {
        setLastSyncedAt(new Date());
        setSyncStatus('synced');
        if (!silent) showToast('บันทึกข้อมูลล่าสุดลง Google Sheets เรียบร้อยแล้ว');
      } else {
        throw new Error(result?.message || 'Save failed');
      }
    } catch (err) {
      console.error('Google Sheet Save Error:', err);
      setSyncStatus('error');
      if (!silent) showToast('บันทึกลง Google Apps Script ไม่สำเร็จ');
    }
  };

  // เปิดเว็บขึ้นมา: ดึงข้อมูลอย่างเดียว (Fetch Only)
  useEffect(() => {
    setIsAutoSyncEnabled(false);
    if (gasUrl && isUrlConnected) {
      fetchFromGoogleSheet(gasUrl, true);
    }
  }, []);

  // ซิงค์อัตโนมัติเฉพาะเมื่อผู้ใช้เปิดโหมด "ซิงค์ Auto"
  useEffect(() => {
    if (!isAutoSyncEnabled || !gasUrl || !isUrlConnected) return;
    if (isRemoteUpdateRef.current) {
      isRemoteUpdateRef.current = false;
      return;
    }

    setSyncStatus('saving');
    const timer = setTimeout(() => {
      pushToGoogleSheet(gasUrl, sheets, activeSheetId, true);
    }, 650);

    return () => clearTimeout(timer);
  }, [sheets, activeSheetId, gasUrl, isUrlConnected, isAutoSyncEnabled]);

  // ปุ่มสลับเปิด/ปิดโหมด "ซิงค์ Auto"
